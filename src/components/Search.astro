---
import { withBase } from '../config/site';
import Icon from './Icon.astro';
---

<dialog
  id="search-dialog"
  class="m-auto mt-[10vh] w-[min(100%-2rem,40rem)] max-h-[75dvh] rounded-xl border border-hairline bg-surface-container-lowest p-0 text-on-surface shadow-[var(--shadow-soft)] backdrop:bg-inverse-surface/40"
  aria-label="Search writing"
  data-pagefind-url={withBase('/pagefind/pagefind.js')}
  data-base={withBase('/')}
>
  <div class="flex items-center gap-2 border-b border-hairline px-4">
    <Icon name="search" class="size-5 shrink-0 text-outline" />
    <input
      type="search"
      data-search-input
      class="h-12 w-full bg-transparent text-base outline-none placeholder:text-outline"
      placeholder="Search titles, topics, and content"
      aria-label="Search query"
      autocomplete="off"
    />
    <button type="button" data-search-close class="inline-flex size-11 md:size-8 items-center justify-center rounded-lg text-on-surface-variant hover:bg-surface-container" aria-label="Close search">
      <Icon name="close" class="size-[18px]" />
    </button>
  </div>
  <div class="max-h-[55dvh] overflow-y-auto p-2" data-search-results aria-live="polite">
    <p class="px-3 py-6 text-center text-sm text-on-surface-variant" data-search-status>Type to search.</p>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
  if (dialog) {
    const input = dialog.querySelector<HTMLInputElement>('[data-search-input]')!;
    const results = dialog.querySelector<HTMLElement>('[data-search-results]')!;
    const base = dialog.dataset.base ?? '/';
    let pagefind: any;
    let loadFailed = false;

    const setStatus = (text: string) => {
      results.replaceChildren();
      const p = document.createElement('p');
      p.className = 'px-3 py-6 text-center text-sm text-on-surface-variant';
      p.textContent = text;
      results.append(p);
    };

    async function load() {
      if (pagefind || loadFailed) return;
      try {
        pagefind = await import(/* @vite-ignore */ dialog!.dataset.pagefindUrl!);
        await pagefind.options({ baseUrl: base });
      } catch {
        loadFailed = true;
        setStatus('Search index is only available in the production build.');
      }
    }

    async function run(query: string) {
      if (!query.trim()) return setStatus('Type to search.');
      await load();
      if (!pagefind) return;
      const search = await pagefind.search(query);
      const items = await Promise.all(search.results.slice(0, 8).map((r: any) => r.data()));
      if (!items.length) return setStatus('No matching writing found.');
      results.replaceChildren();
      for (const item of items) {
        const a = document.createElement('a');
        a.href = item.url;
        a.className = 'block rounded-lg px-3 py-3 hover:bg-surface-container focus-visible:bg-surface-container';
        const h = document.createElement('div');
        h.className = 'font-serif text-lg text-on-surface';
        h.textContent = item.meta?.title ?? item.url;
        const ex = document.createElement('div');
        ex.className = 'mt-1 text-sm text-on-surface-variant [&_mark]:bg-secondary-container [&_mark]:text-on-secondary-container';
        ex.innerHTML = item.excerpt; // excerpt is generated by Pagefind from our own build output
        a.append(h, ex);
        results.append(a);
      }
    }

    let timer: number | undefined;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = window.setTimeout(() => run(input.value), 120);
    });

    const open = () => {
      if (!dialog.open) dialog.showModal();
      input.focus();
      load();
    };
    document.querySelectorAll('[data-search-open]').forEach((el) => el.addEventListener('click', open));
    dialog.querySelector('[data-search-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        open();
      }
    });
  }
</script>
