---
import { paths, type IconName } from './icons';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'w-5 h-5' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
