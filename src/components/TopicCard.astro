---
import { articlePath, pluralize, type Article } from '../lib/articles';
import { withBase } from '../config/site';
import Icon from './Icon.astro';

interface Props {
  index: number;
  id: string;
  title: string;
  description: string;
  count: number;
  featured: Article[];
}

const { index, id, title, description, count, featured } = Astro.props;
---

<section
  class="flex flex-col rounded-xl border border-hairline bg-surface-container-lowest p-6"
  data-filter-item
  data-filter-text={[title, description, ...featured.map((a) => a.data.title)].join(' ').toLowerCase()}
>
  <div class="flex items-start justify-between gap-4 border-b border-hairline pb-4">
    <h2 class="font-serif text-2xl leading-snug text-on-surface">
      <span class="mr-2 font-sans text-[11px] text-primary">{String(index).padStart(2, '0')}</span>{title}
    </h2>
    <span class="shrink-0 rounded-md bg-surface-container-high px-2 py-0.5 text-[11px] text-on-surface-variant">
      {pluralize(count, 'article')}
    </span>
  </div>
  <p class="mt-4 text-[15px] text-on-surface-variant">{description}</p>
  {
    featured.length > 0 && (
      <div class="mt-5">
        <h3 class="text-[11px] font-semibold uppercase tracking-wider text-outline">Featured writing</h3>
        <ul class="mt-2 space-y-1">
          {featured.map((article) => (
            <li>
              <a class="inline-flex min-h-8 items-center gap-2 text-[14px] text-on-surface hover:text-primary" href={withBase(articlePath(article))}>
                <span aria-hidden="true" class="text-outline">—</span>
                {article.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
  <div class="mt-auto flex justify-end pt-6">
    <a href={withBase(`/topics/${id}`)} class="inline-flex min-h-11 items-center gap-1 text-[13px] font-semibold text-primary hover:underline underline-offset-4">
      View writing <Icon name="arrow" class="size-3.5" />
    </a>
  </div>
</section>
