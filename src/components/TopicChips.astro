---
import { siteConfig, withBase } from '../config/site';
import TagChip from './TagChip.astro';

interface Props {
  active?: string;
}

const { active } = Astro.props;
---

<ul class="flex flex-wrap gap-2" aria-label="Topics">
  <li><TagChip href={withBase(siteConfig.paths.posts)} active={!active}>All writing</TagChip></li>
  {
    siteConfig.topics.map((topic) => (
      <li>
        <TagChip href={withBase(`/topics/${topic.id}`)} active={active === topic.id}>
          {topic.title}
        </TagChip>
      </li>
    ))
  }
</ul>
