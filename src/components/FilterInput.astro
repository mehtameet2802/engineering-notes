---
import Icon from './Icon.astro';

interface Props {
  label: string;
  placeholder: string;
}

const { label, placeholder } = Astro.props;
---

<div class="w-full md:max-w-xs">
  <label class="block text-[11px] font-semibold uppercase tracking-wider text-on-surface" for="filter-input">{label}</label>
  <div class="relative mt-1.5">
    <Icon name="search" class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-outline" />
    <input
      id="filter-input"
      type="search"
      data-filter-input
      placeholder={placeholder}
      class="h-11 w-full rounded-lg border border-hairline bg-surface-container-lowest pl-9 pr-3 text-[14px] text-on-surface placeholder:text-outline"
    />
  </div>
</div>

<p class="mt-6 hidden text-center text-on-surface-variant" data-filter-empty>Nothing matches that filter.</p>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-filter-input]');
  const items = document.querySelectorAll<HTMLElement>('[data-filter-item]');
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let visible = 0;
    items.forEach((el) => {
      const match = !q || (el.dataset.filterText ?? '').includes(q);
      el.hidden = !match;
      if (match) visible++;
    });
    empty?.classList.toggle('hidden', visible > 0 || items.length === 0);
  });
</script>
