---
import { siteConfig, getFooterLinks } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="w-full border-t border-hairline bg-surface-container-lowest py-10 mb-16 md:mb-0">
  <div class="page-wrap flex flex-col gap-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
      <div class="flex flex-col gap-1">
        <span class="font-serif text-[20px] font-medium tracking-tight text-on-surface">{siteConfig.name}</span>
        <p class="text-[13px] text-on-surface-variant">{siteConfig.footerTagline}</p>
      </div>
      <nav class="flex flex-wrap items-center gap-x-6 gap-y-2" aria-label="Footer">
        {getFooterLinks().map((item) => (
          <a
            href={item.href}
            class="inline-flex min-h-8 items-center text-[12px] font-semibold tracking-wide text-on-surface-variant hover:text-on-surface"
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>
    <div class="pt-6 border-t border-hairline">
      <p class="text-[13px] text-on-surface-variant">© {year} {siteConfig.name}</p>
    </div>
  </div>
</footer>
