---
interface Step {
  label: string;
  note?: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<ol class="@container flex list-none flex-col items-stretch gap-2 p-0 @lg:flex-row @lg:items-center">
  {
    steps.map((step, i) => (
      <>
        <li class="m-0 flex-1 rounded-md border border-hairline bg-surface-container-lowest px-3 py-2.5 text-center">
          <span class="block text-[13px] font-semibold text-on-surface">{step.label}</span>
          {step.note && <span class="block text-[12px] text-on-surface-variant">{step.note}</span>}
        </li>
        {i < steps.length - 1 && (
          <li aria-hidden="true" class="m-0 text-center text-primary">
            <span class="@lg:hidden">↓</span>
            <span class="hidden @lg:inline">→</span>
          </li>
        )}
      </>
    ))
  }
</ol>
