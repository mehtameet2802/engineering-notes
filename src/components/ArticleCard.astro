---
import { articlePath, formatDate, readingTime, type Article } from '../lib/articles';
import { getTopic, withBase } from '../config/site';
import Icon from './Icon.astro';

interface Props {
  article: Article;
}

const { article } = Astro.props;
const { title, description, date, tags, topic } = article.data;
const href = withBase(articlePath(article));
const searchText = [title, description, getTopic(topic).title, ...tags].join(' ').toLowerCase();
---

<article
  class="@container group relative rounded-lg border border-hairline bg-surface-container-lowest p-5 transition-colors hover:border-outline-variant"
  data-filter-item
  data-filter-text={searchText}
>
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
    <span class="rounded-md border border-hairline bg-surface-container px-2 py-0.5 text-[11px] font-medium text-on-surface-variant">
      {getTopic(topic).title}
    </span>
    <p class="text-[12px] text-outline">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      <span aria-hidden="true"> · </span>{readingTime(article.body ?? '')} min read
    </p>
  </div>
  <h3 class="mt-3 font-serif text-[22px] leading-snug text-on-surface">
    <a href={href} class="after:absolute after:inset-0 group-hover:text-primary">{title}</a>
  </h3>
  <p class="mt-2 max-w-[68ch] text-[15px] leading-relaxed text-on-surface-variant">{description}</p>
  <div class="mt-4 flex items-end justify-between gap-4">
    <ul class="flex flex-wrap gap-x-3 gap-y-1 text-[12px] text-outline" aria-label="Tags">
      {tags.map((tag) => <li>#{tag}</li>)}
    </ul>
    <span class="inline-flex shrink-0 items-center gap-1 text-[13px] font-semibold text-primary" aria-hidden="true">
      Read note <Icon name="arrow" class="size-3.5" />
    </span>
  </div>
</article>
