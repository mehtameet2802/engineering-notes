---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../config/site';
---

<BaseLayout title="Page not found" noindex>
  <section class="page-wrap py-24 text-center">
    <p class="text-[11px] font-semibold uppercase tracking-wider text-primary">404</p>
    <h1 class="mt-2 font-serif text-4xl text-on-surface">Page not found</h1>
    <p class="mt-4 text-on-surface-variant">That page doesn’t exist, or it has moved.</p>
    <a href={withBase('/')} class="mt-6 inline-flex min-h-11 items-center text-primary underline underline-offset-4">Back to writing</a>
  </section>
</BaseLayout>
