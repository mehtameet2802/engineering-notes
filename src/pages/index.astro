---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeaturedArticle from '../components/FeaturedArticle.astro';
import ArticleList from '../components/ArticleList.astro';
import Icon from '../components/Icon.astro';
import { siteConfig, withBase } from '../config/site';
import { getPublishedArticles, getFeaturedArticle } from '../lib/articles';

const articles = await getPublishedArticles();
const featured = getFeaturedArticle(articles);
const latest = articles.filter((a) => a.id !== featured?.id).slice(0, 5);
---

<BaseLayout current="home">
  <section class="page-wrap pt-12 md:pt-16">
    <h1 class="font-serif text-[clamp(2.25rem,6vw,3.5rem)] leading-[1.1] tracking-tight text-on-surface">
      {siteConfig.name}
    </h1>
    <p class="mt-2 font-serif text-[clamp(1.25rem,3vw,1.75rem)] italic text-primary">{siteConfig.subtitle}</p>
    <p class="mt-6 max-w-[52ch] text-[17px] text-on-surface-variant">{siteConfig.intro}</p>
  </section>

  {
    featured && (
      <section class="page-wrap mt-12 md:mt-16" aria-labelledby="featured-heading">
        <h2 id="featured-heading" class="mb-3 flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider text-on-surface-variant">
          <Icon name="star" class="size-3.5 text-primary" /> Featured writing
        </h2>
        <FeaturedArticle article={featured} />
      </section>
    )
  }

  {
    articles.length > 0 && (
      <section class="page-wrap mt-14 pb-16" aria-labelledby="latest-heading">
        <SectionHeading
          title="Latest writing"
          id="latest-heading"
          description="Recent notes and explorations on engineering, design, and problem solving."
        />
        <div class="mt-6">
          <ArticleList articles={latest} emptyMessage="More writing coming soon." />
        </div>
        <div class="mt-8 text-center">
          <a href={withBase(siteConfig.paths.posts)} class="inline-flex min-h-11 items-center gap-2 rounded-lg border border-hairline bg-surface-container px-5 text-[13px] font-medium text-on-surface hover:bg-surface-container-high">
            View all writing <Icon name="arrow" class="size-4" />
          </a>
        </div>
      </section>
    )
  }
</BaseLayout>
